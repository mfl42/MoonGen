#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/vmoongen-env.sh
source "$SCRIPT_DIR/vmoongen-env.sh"
S="$ROOT/scripts"

usage() {
  cat <<USAGE
Usage:
  vmoongenctl render-vpp-conf [target]
  vmoongenctl start-vpp-host
  vmoongenctl stop-vpp-host
  vmoongenctl status-vpp-host
  vmoongenctl start-lab
  vmoongenctl stop-lab
  vmoongenctl restart-lab
  vmoongenctl start-fp [script] [ports]
  vmoongenctl stop-fp
  vmoongenctl restart-fp [script] [ports]
  vmoongenctl status-fp
  vmoongenctl start-daemon
  vmoongenctl stop-daemon
  vmoongenctl status-cp
  vmoongenctl check-lab
  vmoongenctl check-fp-ready
  vmoongenctl check-vpp-fastpath
  vmoongenctl check-vpp-build
  vmoongenctl check-vpp-build-sources
  vmoongenctl bootstrap-dpdk-mirror
  vmoongenctl build-vpp-image
  vmoongenctl build-vpp-system-dpdk
  vmoongenctl scenario-ast <scenario.lua>
  vmoongenctl scenario-plan <scenario.lua>
  vmoongenctl scenario-v1 <scenario.lua>
  vmoongenctl scenario-worker-plan <scenario.lua> [--workers N] [--shard-strategy contiguous|round_robin]
  vmoongenctl scenario-run <scenario.lua> [--workers N] [--step-s N] [--out-dir DIR]
  vmoongenctl scenario-replay <worker-plan.json> [--step-s N] [--target-cps-override N] [--out-dir DIR]
  vmoongenctl scenario-campaign <scenario.lua> [--workers N] [--iterations N] [--out-dir DIR]
  vmoongenctl scenario-smoke [local|remote|both] [--host user@ip] [--workers N]
  vmoongenctl check-fp-deps
  vmoongenctl check-nics
  vmoongenctl dpdk-reset
USAGE
}

require_luajit() {
  if ! vmoongen_have_luajit; then
    echo "[ERROR] No LuaJIT binary found. Set VMOONGEN_LUAJIT_BIN or build LuaJIT under libmoon/deps." >&2
    exit 1
  fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
  render-vpp-conf) exec "$S/render-vpp-session-conf.sh" "$@" ;;
  start-vpp-host) exec "$S/start-vpp-host.sh" "$@" ;;
  stop-vpp-host)  exec "$S/stop-vpp-host.sh" "$@" ;;
  status-vpp-host) exec "$S/status-vpp-host.sh" "$@" ;;
  start-lab)    exec "$S/start-lab.sh" "$@" ;;
  stop-lab)     exec "$S/stop-lab.sh" "$@" ;;
  restart-lab)  "$S/stop-lab.sh" || true; exec "$S/start-lab.sh" "$@" ;;
  start-fp)     exec "$S/start-fastpath.sh" "$@" ;;
  stop-fp)      exec "$S/stop-fastpath.sh" "$@" ;;
  restart-fp)   exec "$S/restart-fastpath.sh" "$@" ;;
  status-fp)    exec "$S/status-fastpath.sh" "$@" ;;
  start-daemon) exec "$S/start-daemon.sh" "$@" ;;
  stop-daemon)  exec "$S/stop-daemon.sh" "$@" ;;
  status-cp)    exec "$S/status-controlplane.sh" "$@" ;;
  check-lab)    exec "$S/check-lab.sh" "$@" ;;
  check-fp-ready) exec "$S/check-fastpath-ready.sh" "$@" ;;
  check-vpp-fastpath) exec "$S/check-vpp-fastpath-support.sh" "$@" ;;
  check-vpp-build) exec "$S/check-vpp-build-prereqs.sh" "$@" ;;
  check-vpp-build-sources) exec "$S/check-vpp-build-sources.sh" "$@" ;;
  bootstrap-dpdk-mirror) exec "$S/bootstrap-dpdk-mirror.sh" "$@" ;;
  build-vpp-image) exec "$S/build-vpp-build-image.sh" "$@" ;;
  build-vpp-system-dpdk) exec "$S/build-vpp-system-dpdk.sh" "$@" ;;
  scenario-ast)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_dsl_compile.lua" "$@" --ast
    ;;
  scenario-plan)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_dsl_compile.lua" "$@" --plan
    ;;
  scenario-v1)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_dsl_compile.lua" "$@" --scenario-v1
    ;;
  scenario-worker-plan)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_dsl_compile.lua" "$@" --worker-plan
    ;;
  scenario-run)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_runtime_skeleton.lua" "$@"
    ;;
  scenario-replay)
    require_luajit
    if [[ $# -lt 1 ]]; then
      echo "[ERROR] Usage: vmoongenctl scenario-replay <worker-plan.json> [runtime options]" >&2
      exit 1
    fi
    wp="$1"
    shift
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_runtime_skeleton.lua" --worker-plan-file "$wp" "$@"
    ;;
  scenario-campaign)
    require_luajit
    exec "$VMOONGEN_LUAJIT_BIN" "$ROOT/tools/scenario_campaign.lua" "$@"
    ;;
  scenario-smoke)
    exec "$S/scenario-smoke.sh" "$@"
    ;;
  check-fp-deps) exec "$S/check-moongen-deps.sh" "$@" ;;
  check-nics)   exec "$S/check-nics.sh" "$@" ;;
  dpdk-reset)   exec "$S/dpdk-reset.sh" "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
esac
